RAG_BASE_URL=http://orca-infer.ai
# RAG_BASE_HOST is supported for backward compatibility.
# RAG_BASE_HOST=infer.hawk-llm.ai

VITE_KEYCLOAK_ENABLED=true
VITE_KEYCLOAK_URL=https://orca-infer.ai/auth
VITE_KEYCLOAK_REALM=orca
VITE_KEYCLOAK_CLIENT_ID=orca-client

# Feedback is served by a separate private service. These values are read only
# by the server-side feedback proxy; never prefix them with VITE_.
FEEDBACK_BASE_URL=http://orca-feedback:8080
KEYCLOAK_ISSUER=https://orca-infer.ai/auth/realms/orca
# Required: must exactly match the access-token aud claim. Do not guess this.
KEYCLOAK_AUDIENCE=
# Optional server-only signing-key URL when the public issuer is unreachable.
# KEYCLOAK_JWKS_URL=http://kc-keycloakx-http.hawk.svc.cluster.local/auth/realms/orca/protocol/openid-connect/certs
